# Скопируйте этот файл в .env и замените значения на свои.
# Файл .env в репозиторий не добавляется (см. .gitignore).

POSTGRES_DB=booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=replace-with-strong-password

# Токен для создания ресурсов через POST /api/resources (заголовок X-Admin-Token)
ADMIN_TOKEN=replace-with-random-token

GRAFANA_USER=admin
GRAFANA_PASSWORD=replace-with-strong-password

APP_TIMEZONE=Europe/Moscow
